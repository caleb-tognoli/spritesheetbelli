{{! spritesheetbelli template
name: CSS sprites
extension: css
per_page: false
rotation: none
layouts: grid, packed

A class for every frame, .sprite- and its name as a CSS identifier, with its size and
place in the image, and the "sprite" class with what they share, the first page's image
among it; frames on other pages get their own page's. A trimmed frame's margins put back
its transparent borders, so it takes the room of the whole frame. CSS can't show turned
frames.
}}
/* Written by {{app}}. Give an element the "sprite" class and a frame's class:
   <span class="sprite sprite-walk_0"></span> */

.sprite {
	display: inline-block;
	overflow: hidden;
	background-image: url("{{image | json-escape}}");
	background-repeat: no-repeat;
}
{{#pages}}
{{^@first}}

{{#frames}}
.sprite-{{name | css-ident}}{{^@last}},{{/@last}}{{#@last}} {{{/@last}}
{{/frames}}
	background-image: url("{{image | json-escape}}");
}
{{/@first}}
{{/pages}}
{{#frames}}

.sprite-{{name | css-ident}} {
	width: {{w}}px;
	height: {{h}}px;
	background-position: {{x | negate}}px {{y | negate}}px;
{{#trimmed}}
	margin: {{trim_top}}px {{trim_right}}px {{trim_bottom}}px {{trim_left}}px;
{{/trimmed}}
}
{{/frames}}
{{! Scale variants: a page's "retina_image", its image at twice the size, would be shown
on screens with two or more pixels to a CSS pixel. Nothing sets it yet. }}
{{#pages}}
{{#retina_image}}

@media (-webkit-min-device-pixel-ratio: 2), (min-resolution: 2dppx) {
	{{#@first}}.sprite{{/@first}}{{^@first}}{{#frames}}.sprite-{{name | css-ident}}{{^@last}}, {{/@last}}{{/frames}}{{/@first}} {
		background-image: url("{{retina_image | json-escape}}");
		background-size: {{w}}px {{h}}px;
	}
}
{{/retina_image}}
{{/pages}}

