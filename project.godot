; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="spritesheetbelli"
run/main_scene="res://ui/main/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Global="*res://scripts/autoloaded/global.gd"
Actions="*res://scripts/autoloaded/actions.gd"
Notify="*res://scripts/autoloaded/notify.gd"

[debug]

gdscript/warnings/integer_division=0

[display]

window/size/viewport_width=1000
window/subwindows/embed_subwindows=false

[file_customization]

folder_colors={
"res://assets/": "yellow",
"res://resources/": "purple",
"res://scripts/": "gray",
"res://ui/": "green"
}

[filesystem]

import/blender/enabled=false

[gui]

theme/custom="res://resources/themes/main_theme.tres"

