{{! spritesheetbelli template
name: Construct 3 import settings
extension: json
per_page: false
rotation: none
layouts: grid

The settings file Construct 3's Animations Editor reads from a folder dropped on it,
which makes one animation of the sheet in the folder, cutting it into its columns and
rows and taking every cell in reading order. Construct only reads it as
c3-import-settings.json: export the sheet as c3-import-settings.png into a folder named
after the animation, with no padding, spacing or extrusion, and drop the folder on the
Animations panel. The animation gets the speed and looping of the sheet's first
animation, or else the export's speed.
}}
{
	"import-mode": "spritesheet",
	"spritesheet": {
		"horizontal-cells": {{columns}},
		"vertical-cells": {{rows}},
		"direction": "horizontal"
	},
	"animation": {
{{#animations.0}}
		"speed": {{fps | json}},
		"loop": {{loop}},
		"ping-pong": {{ping_pong}}
{{/animations.0}}
{{^animations}}
		"speed": {{fps | json}},
		"loop": true,
		"ping-pong": false
{{/animations}}
	}
}

