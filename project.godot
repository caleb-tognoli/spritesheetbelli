; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="spritesheetbelli"
config/description="Combine sprites into spritesheets and cut spritesheets into sprites."
config/version="0.2.0"
run/main_scene="res://ui/main/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.105882, 0.109804, 0.121569, 1)
boot_splash/stretch_mode=0
boot_splash/image="res://assets/branding/splash.png"
config/icon="res://icon.svg"
config/macos_native_icon="res://assets/branding/icon.icns"
config/windows_native_icon="res://assets/branding/icon.ico"

[autoload]

Settings="*res://scripts/autoloaded/settings.gd"
Global="*res://scripts/autoloaded/global.gd"
Actions="*res://scripts/autoloaded/actions.gd"
Notify="*res://scripts/autoloaded/notify.gd"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/integer_division=0

[display]

window/size/viewport_width=1000
window/subwindows/embed_subwindows=false

[file_customization]

folder_colors={
"res://assets/": "yellow",
"res://resources/": "purple",
"res://scripts/": "gray",
"res://ui/": "green"
}

[filesystem]

import/blender/enabled=false

[gui]

theme/custom="res://resources/themes/app_theme.tres"

